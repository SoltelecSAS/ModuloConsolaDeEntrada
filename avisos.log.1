 pr.id_pruebas in( select max(id_pruebas) from pruebas as p where p.hoja_pruebas_for = ?  and p.Tipo_prueba_for = 1  and p.Finalizada = 'Y'  and p.Abortada = 'N'  and gsg.id_grupo = 21  group by p.Tipo_prueba_for)
END
and pr.hoja_pruebas_for = ?
/*and d.CARDEFAULT not in (84000,84001,84002,84003,84010,84011,84012,84009) */

     v.`Numero_motor`,
     v.`Numero_licencia`,
     p.`Tipo_identificacion`,
     hp.`TESTSHEET`,
     ciudades.`Nombre_ciudad`,
     d.`nombre_departamento`,
     m.`Nombre_marca`,
     l.`CRLNAME`,
     cl.`Nombre_clase`,
     s.`Nombre_servicio`,
     tg.`FUELTYPE`,

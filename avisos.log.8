                WHERE 
                    p.hoja_pruebas_for = ?  
                    AND p.Tipo_prueba_for != 1  
                    AND p.Finalizada = 'Y'  
                    AND p.Abortada = 'N' 
                GROUP BY p.Tipo_prueba_for
            )
    END

                SELECT MIN(id_pruebas)
                FROM pruebas AS p
                WHERE 
                    p.hoja_pruebas_for = ?
                    AND p.tipo_prueba_for = 1
                    AND p.finalizada = 'Y'
                    AND p.abortada = 'N'
                GROUP BY p.tipo_prueba_for
            )
        ELSE 
            pr.id_pruebas IN (
                SELECT MAX(id_pruebas)

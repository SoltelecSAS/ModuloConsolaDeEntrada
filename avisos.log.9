    Nombre_problema,
    d.Tipo_defecto,
    COALESCE(g.Nombre_grupo, d.grupo) AS Nombre_grupo,
    d.codigo_super AS CARDEFAULT, 
    d.codigo_Resolucion AS d_codigo_Resolucion
FROM 
    pruebas pr
INNER JOIN 
    defxprueba dp ON pr.id_pruebas = dp.id_prueba
    AND IFNULL(dp.tercer_estado, '') NOT IN ('na')
INNER JOIN 
    defectos AS d ON dp.id_defecto = d.cardefault
LEFT JOIN 
    defectos_grupos_sub_grupos gsg ON gsg.id_sub_grupo = d.defgroupssub
LEFT JOIN 
    grupos g ON gsg.id_grupo = g.DEFGROUP
WHERE 
    CASE
        WHEN ? = 'NO' THEN 
            pr.id_pruebas IN (
                SELECT MIN(id_pruebas)
                FROM pruebas AS p
                WHERE 
                    p.hoja_pruebas_for = ?
                    AND p.tipo_prueba_for = 1
                    AND p.finalizada = 'Y'
                    AND p.abortada = 'N'
                GROUP BY p.tipo_prueba_for
            )
        ELSE 
            pr.id_pruebas IN (
                SELECT MAX(id_pruebas)
                FROM pruebas AS p
                WHERE 
                    p.hoja_pruebas_for = ?
                    AND p.tipo_prueba_for = 1
                    AND p.finalizada = 'Y'
                    AND p.abortada = 'N'
                GROUP BY p.tipo_prueba_for
            )
    END
AND pr.hoja_pruebas_for = ?

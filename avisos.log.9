                        WHERE  p.hoja_pruebas_for = ?
                        AND    p.tipo_prueba_for = 1
                        AND    p.finalizada = 'Y'
                        AND    p.abortada = 'N'
                        AND    gsg.id_grupo != 21
                        GROUP BY p.tipo_prueba_for)
                END
AND             pr.hoja_pruebas_for = ?

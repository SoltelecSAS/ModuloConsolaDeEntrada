                    AND p.Abortada = 'N' 
                GROUP BY p.Tipo_prueba_for
            )
        ELSE
            pr.id_pruebas IN (
                SELECT MAX(id_pruebas) 
                FROM pruebas AS p 
                WHERE 
                    p.hoja_pruebas_for = ?  
                    AND p.Tipo_prueba_for != 1  
                    AND p.Finalizada = 'Y'  
                    AND p.Abortada = 'N' 
                GROUP BY p.Tipo_prueba_for
            )
    END
    AND pr.hoja_pruebas_for = ?

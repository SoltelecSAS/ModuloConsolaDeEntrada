                        WHERE  p.hoja_pruebas_for = $p{id_hojaprueba}
                        AND    p.tipo_prueba_for = 1
                        AND    p.finalizada = 'Y'
                        AND    p.abortada = 'N'
                        AND    gsg.id_grupo != 21
                        GROUP BY p.tipo_prueba_for )
                ELSE pr.id_pruebas IN (
                        SELECT MAX(id_pruebas)
                        FROM   pruebas AS p
                        WHERE  p.hoja_pruebas_for = $p{id_hojaprueba}
                        AND    p.tipo_prueba_for = 1
                        AND    p.finalizada = 'Y'
                        AND    p.abortada = 'N'
                        AND    gsg.id_grupo != 21
                        GROUP BY p.tipo_prueba_for)
                END
AND             pr.hoja_pruebas_for = $p{id_hojaprueba}

LEFT JOIN 
    grupos g ON gsg.id_grupo = g.DEFGROUP
WHERE 
    CASE
        WHEN ? = 'NO' THEN 
            pr.id_pruebas IN (
                SELECT MIN(id_pruebas)
                FROM pruebas AS p
                WHERE 
                    p.hoja_pruebas_for = ?
                    AND p.tipo_prueba_for = 1
                    AND p.finalizada = 'Y'
                    AND p.abortada = 'N'
                GROUP BY p.tipo_prueba_for
            )
        ELSE 
            pr.id_pruebas IN (
                SELECT MAX(id_pruebas)
                FROM pruebas AS p
                WHERE 
                    p.hoja_pruebas_for = ?
                    AND p.tipo_prueba_for = 1
                    AND p.finalizada = 'Y'
                    AND p.abortada = 'N'
                GROUP BY p.tipo_prueba_for
            )
    END
AND pr.hoja_pruebas_for = ?

     cda.`orden_bienvenido` AS cda_orden_bienvenido,
     cda.`password_sicov` AS cda_password_sicov,
     cda.`orden_contrato` AS cda_orden_contrato,
     cda.`orden_version` AS cda_orden_version,
     cda.`orden_fecha` AS cda_orden_fecha,
     cda.`url_servicio_sicov` AS cda_url_servicio_sicov,
     cda.`url_servicio_sicov2` AS cda_url_servicio_sicov2,
     cda.`url_servicio_encript` AS cda_url_servicio_encript,
     cda.`id_runt` AS cda_id_runt,
     cda.`cont_test` AS cda_cont_test,
     cda.`orden_codigo` AS cda_orden_codigo,
     v.`Fecha_exp_soat` AS v_Fecha_exp_soat,
     v.`Fecha_soat` AS v_Fecha_soat,
     p.`email` AS p_email,
     hp.`Numero_intentos` AS hp_Numero_intentos,
     software.`nombre` AS software_nombre,
     software.`version` AS software_version,
     software.`Id_sw` AS software_Id_sw,
     min(software.`Id_sw`),
     CASE when hp.Aprobado = 'Y' then 'A' ELSE 'R' END estadoHoja
FROM
     `hoja_pruebas` hp INNER JOIN `vehiculos` v ON hp.`Vehiculo_for` = v.`CAR`
     INNER JOIN `propietarios` p ON hp.`Propietario_for` = p.`CAROWNER`
     INNER JOIN `ciudades` ciudades ON p.`CITY` = ciudades.`CITY`
     INNER JOIN `departamentos` d ON ciudades.`STATE` = d.`id_departamento`
     INNER JOIN `marcas` m ON v.`CARMARK` = m.`CARMARK`
     INNER JOIN `lineas_vehiculos` l ON v.`CARLINE` = l.`CARLINE`
     INNER JOIN `clases_vehiculo` cl ON v.`CLASS` = cl.`CLASS`
     INNER JOIN `servicios` s ON v.`SERVICE` = s.`SERVICE`
     INNER JOIN `tipos_gasolina` tg ON v.`FUELTYPE` = tg.`FUELTYPE`
     INNER JOIN `colores` clr ON v.`COLOR` = clr.`COLOR`
     INNER JOIN `pais` pais ON v.`pais` = pais.`codigo`
     LEFT JOIN tipo_carroceria tp ON v.carroceria = tp.id,
     `cda` cda,
     `software` software
WHERE
     hp.TESTSHEET = ?

FROM            pruebas pr
INNER JOIN      defxprueba dp ON pr.id_pruebas = dp.id_prueba
AND             IFNULL(dp.tercer_estado, '') NOT IN ('na')
INNER JOIN      defectos AS d ON dp.id_defecto = d.cardefault
INNER JOIN      defectos_grupos_sub_grupos gsg ON gsg.id_sub_grupo = d.defgroupssub
INNER JOIN      grupos AS g ON gsg.id_grupo = g.defgroup
WHERE           CASE
                WHEN ? = 'NO' THEN pr.id_pruebas IN (
                        SELECT MIN(id_pruebas)
                        FROM   pruebas AS p
                        WHERE  p.hoja_pruebas_for = ?
                        AND    p.tipo_prueba_for = 1
                        AND    p.finalizada = 'Y'
                        AND    p.abortada = 'N'
                        AND    gsg.id_grupo != 21
                        GROUP BY p.tipo_prueba_for )
                ELSE pr.id_pruebas IN (
                        SELECT MAX(id_pruebas)
                        FROM   pruebas AS p
                        WHERE  p.hoja_pruebas_for = ?
                        AND    p.tipo_prueba_for = 1
                        AND    p.finalizada = 'Y'
                        AND    p.abortada = 'N'
                        AND    gsg.id_grupo != 21
                        GROUP BY p.tipo_prueba_for)
                END
AND             pr.hoja_pruebas_for = ?

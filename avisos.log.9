[2024-08-21 10:45:09] [ DEBUG] [JRJdbcQueryExecuter:382] SQL query string: select DISTINCT Nombre_problema,d.Tipo_defecto,Nombre_grupo,d.codigo_super as CARDEFAULT,d.`codigo_Resolucion` AS d_codigo_Resolucion from pruebas as pr
inner join defxprueba as dp on pr.id_pruebas=dp.id_prueba
inner join defectos as d on dp.id_defecto = d.CARDEFAULT
INNER JOIN grupos_sub_grupos gsg on gsg.SCDEFGROUPSUB = d.DEFGROUPSSUB
inner join grupos as g on gsg.DEFGROUP = g.DEFGROUP
where
CASE WHEN ?="NO" THEN
 pr.id_pruebas in (
select min(id_pruebas) from pruebas as p where p.hoja_pruebas_for = ?  and p.Tipo_prueba_for != 1  and p.Finalizada = 'Y'  and p.Abortada = 'N' group by p.Tipo_prueba_for)
ELSE
 pr.id_pruebas in (
 select max(id_pruebas) from pruebas as p where p.hoja_pruebas_for = ?  and p.Tipo_prueba_for != 1  and p.Finalizada = 'Y'  and p.Abortada = 'N' group by p.Tipo_prueba_for)
 END
and pr.hoja_pruebas_for = ?
/*and d.CARDEFAULT not in (84000,84001,84002,84003,84010,84011,84012,84009) */

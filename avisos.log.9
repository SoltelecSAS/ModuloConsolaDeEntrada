[2024-09-02 12:43:04] [ DEBUG] [JRJdbcQueryExecuter:382] SQL query string: SELECT DISTINCT 
    Nombre_problema,
    d.Tipo_defecto,
    COALESCE(g.Nombre_grupo, '') AS Nombre_grupo,
    d.codigo_super AS CARDEFAULT,
    d.codigo_Resolucion AS d_codigo_Resolucion
FROM 
    pruebas AS pr
INNER JOIN 
    defxprueba AS dp ON pr.id_pruebas = dp.id_prueba
INNER JOIN 
    defectos AS d ON dp.id_defecto = d.CARDEFAULT
LEFT JOIN 
    defectos_grupos_sub_grupos AS gsg ON gsg.id_sub_grupo = d.defgroupssub
LEFT JOIN 
    grupos AS g ON gsg.id_grupo = g.defgroup
WHERE 
    CASE 
        WHEN ? = 'SI' THEN
            pr.id_pruebas IN (
                SELECT MIN(id_pruebas) 
                FROM pruebas AS p 
                WHERE 
                    p.hoja_pruebas_for = ? 
                    AND p.Tipo_prueba_for = 1 
                    AND p.Finalizada = 'Y' 
                    AND gsg.id_grupo = 21  
                GROUP BY p.Tipo_prueba_for
            )
        ELSE
            pr.id_pruebas IN (
                SELECT MAX(id_pruebas) 
                FROM pruebas AS p 
                WHERE 
                    p.hoja_pruebas_for = ?  
                    AND p.Tipo_prueba_for = 1  
                    AND p.Finalizada = 'Y'  
                    AND p.Abortada = 'N'  
                    AND gsg.id_grupo = 21  
                GROUP BY p.Tipo_prueba_for
            )
    END
    AND pr.hoja_pruebas_for = ?
/*and d.CARDEFAULT not in (84000,84001,84002,84003,84010,84011,84012,84009) */

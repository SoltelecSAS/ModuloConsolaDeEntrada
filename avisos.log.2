[2025-01-11 20:18:10] [ DEBUG] [JRJdbcQueryExecuter:382] SQL query string: SELECT DISTINCT 
    Nombre_problema,
    d.Tipo_defecto,
    COALESCE(Nombre_grupo, d.grupo) AS Nombre_grupo,
    d.codigo_super AS CARDEFAULT,
    d.`codigo_Resolucion` AS d_codigo_Resolucion
FROM 
    pruebas AS pr
INNER JOIN 
    defxprueba AS dp 
    ON pr.id_pruebas = dp.id_prueba 
    AND IFNULL(dp.tercer_estado, '') NOT IN ('na')
INNER JOIN 
    defectos AS d 
    ON dp.id_defecto = d.CARDEFAULT
LEFT JOIN 
    grupos_sub_grupos gsg 
    ON gsg.SCDEFGROUPSUB = d.DEFGROUPSSUB
LEFT JOIN 
    grupos AS g 
    ON gsg.DEFGROUP = g.DEFGROUP
WHERE 
    CASE 
        WHEN ? = "NO" THEN
            pr.id_pruebas IN (
                SELECT MIN(id_pruebas) 
                FROM pruebas AS p 
                WHERE p.hoja_pruebas_for = ?
                AND p.Tipo_prueba_for = 1 
                AND p.Finalizada = 'Y' 
                AND p.Abortada = 'N' 
                GROUP BY p.Tipo_prueba_for
            )
        ELSE
            pr.id_pruebas IN (
                SELECT MAX(id_pruebas) 
                FROM pruebas AS p 
                WHERE p.hoja_pruebas_for = ?
                AND p.Tipo_prueba_for = 1 
                AND p.Finalizada = 'Y' 
                AND p.Abortada = 'N' 
                GROUP BY p.Tipo_prueba_for
            )
    END
AND pr.hoja_pruebas_for = ? AND d.DEFGROUPSSUB <> 56

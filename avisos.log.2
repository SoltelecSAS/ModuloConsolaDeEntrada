INNER JOIN 
    defectos AS d 
    ON dp.id_defecto = d.CARDEFAULT
LEFT JOIN 
    grupos_sub_grupos gsg 
    ON gsg.SCDEFGROUPSUB = d.DEFGROUPSSUB
LEFT JOIN 
    grupos AS g 
    ON gsg.DEFGROUP = g.DEFGROUP
WHERE 
    CASE 
        WHEN ? = "NO" THEN
            pr.id_pruebas IN (
                SELECT MIN(id_pruebas) 
                FROM pruebas AS p 
                WHERE p.hoja_pruebas_for = ?
                AND p.Tipo_prueba_for = 1 
                AND p.Finalizada = 'Y' 
                AND p.Abortada = 'N' 
                GROUP BY p.Tipo_prueba_for
            )
        ELSE
            pr.id_pruebas IN (
                SELECT MAX(id_pruebas) 
                FROM pruebas AS p 
                WHERE p.hoja_pruebas_for = ?
                AND p.Tipo_prueba_for = 1 
                AND p.Finalizada = 'Y' 
                AND p.Abortada = 'N' 
                GROUP BY p.Tipo_prueba_for
            )
    END
AND pr.hoja_pruebas_for = ? AND d.DEFGROUPSSUB <> 56
-- AND d.CARDEFAULT NOT IN (84000, 84001, 84002, 84003, 84010, 84011, 84012, 84009)

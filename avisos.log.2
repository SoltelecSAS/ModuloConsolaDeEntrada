[2025-01-11 20:14:01] [ DEBUG] [JRJdbcQueryExecuter:382] SQL query string: select Nombre_usuario,Nombre_tipo_prueba from  pruebas as pr
inner join hoja_pruebas as hp on pr.hoja_pruebas_for = hp.TESTSHEET inner join usuarios as u on pr.usuario_for = u.GEUSER inner join tipo_prueba as tp on pr.Tipo_prueba_for = tp.TESTTYPE
where CASE WHEN ?="NO" THEN
     pr.id_pruebas in (select Min(id_pruebas) from pruebas as p where p.hoja_pruebas_for =?     and p.Finalizada = 'Y' group by p.Tipo_prueba_for )
 ELSE
      pr.id_pruebas in (select Max(id_pruebas) from pruebas as p where p.hoja_pruebas_for =?     and p.Finalizada = 'Y' group by p.Tipo_prueba_for )
END
    and pr.hoja_pruebas_for = ?

     cda.`RESOLUCION` AS cda_RESOLUCION,
     cda.`fecha_resolucion` AS cda_fecha_resolucion,
     cda.`codigo` AS cda_codigo,
     cda.`nom_resp_certificados` AS cda_nom_resp_certificados,
     cda.`Certificado_conformidad` AS cda_Certificado_conformidad,
     cda.`ciudad` AS cda_ciudad,
     cda.`consecutivo_apr` AS cda_consecutivo_apr,
     cda.`consecutivo_rep` AS cda_consecutivo_rep,
     cda.`consecutivo_cert` AS cda_consecutivo_cert,

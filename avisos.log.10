[2024-10-31 12:01:14] [ DEBUG] [JRJdbcQueryExecuter:382] SQL query string: select DISTINCT Nombre_problema,d.Tipo_defecto,Nombre_grupo,d.codigo_super as CARDEFAULT,     d.`codigo_Resolucion` AS d_codigo_Resolucion from pruebas as pr

inner join defxprueba as dp on pr.id_pruebas=dp.id_prueba
inner join defectos as d on dp.id_defecto = d.CARDEFAULT
INNER JOIN      defectos_grupos_sub_grupos gsg ON gsg.id_sub_grupo = d.defgroupssub
INNER JOIN      grupos AS g ON gsg.id_grupo = g.defgroup
where CASE WHEN ?="SI" THEN
 pr.id_pruebas in (
select MIN(id_pruebas) from pruebas as p where p.hoja_pruebas_for =  ? and p.Tipo_prueba_for = 1 and p.Finalizada = 'Y' and gsg.id_grupo = 21  group by p.Tipo_prueba_for)
ELSE
 pr.id_pruebas in( select max(id_pruebas) from pruebas as p where p.hoja_pruebas_for = ?  and p.Tipo_prueba_for = 1  and p.Finalizada = 'Y'  and p.Abortada = 'N'  and gsg.id_grupo = 21  group by p.Tipo_prueba_for)
END
and pr.hoja_pruebas_for = ?
/*and d.CARDEFAULT not in (84000,84001,84002,84003,84010,84011,84012,84009) */

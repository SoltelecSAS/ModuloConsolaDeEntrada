     AS v_carroceria,
     v.`potencia` AS v_potencia,
     v.`conversion_gnv` AS v_conversion_gnv,
     hp.`kilometraje_rtm` AS hp_kilometraje_rtm,
     hp.`fecha_venc_gnv` AS hp_fecha_venc_gnv,
     cda.`id_cda` AS cda_id_cda,

     v.`Modelo`,
     v.`Cinlindraje`,
     v.`VIN`,
     v.`numero_chasis`,
     v.`Numero_motor`,
     v.`Numero_licencia`,
     p.`Tipo_identificacion`,
     hp.`TESTSHEET`,
     ciudades.`Nombre_ciudad`,
     d.`nombre_departamento`,
     m.`Nombre_marca`,
     l.`CRLNAME`,
     cl.`Nombre_clase`,
     s.`Nombre_servicio`,
     tg.`FUELTYPE`,
     tg.`Nombre_gasolina`,
     clr.`Nombre_color`,
     pais.`Nombre_pais`,
     v.`Fecha_registro`,
     v.`Tiempos_motor`,
     v.`CARTYPE`,
     v.`kilometraje`,
     v.`numero_sillas`,
     v.`blindaje`,
     v.`vidrios_polarizados`,
     v.`diseño`,
     CASE when  v.`carroceria` IS null then 'Sin carroceria' ELSE tp.nombre_carroceria END
     AS v_carroceria,
     v.`potencia` AS v_potencia,
     v.`conversion_gnv` AS v_conversion_gnv,
     hp.`kilometraje_rtm` AS hp_kilometraje_rtm,
     hp.`fecha_venc_gnv` AS hp_fecha_venc_gnv,
     cda.`id_cda` AS cda_id_cda,
     cda.`nombre` AS cda_nombre,
     cda.`NIT` AS cda_NIT,
     cda.`direccion` AS cda_direccion,
     cda.`telefono` AS cda_telefono,
     cda.`clase_cda` AS cda_clase_cda,
     cda.`celular` AS cda_celular,
     cda.`correo` AS cda_correo,
     cda.`RESOLUCION` AS cda_RESOLUCION,
     cda.`fecha_resolucion` AS cda_fecha_resolucion,
     cda.`codigo` AS cda_codigo,
     cda.`nom_resp_certificados` AS cda_nom_resp_certificados,
     cda.`Certificado_conformidad` AS cda_Certificado_conformidad,
     cda.`ciudad` AS cda_ciudad,
     cda.`consecutivo_apr` AS cda_consecutivo_apr,
     cda.`consecutivo_rep` AS cda_consecutivo_rep,
     cda.`consecutivo_cert` AS cda_consecutivo_cert,
     cda.`codigo_runt_cda` AS cda_cod_runt_cda,
     cda.`codigo_runt_proveedor` AS cda_cod_runt_proveedor,
     cda.`usuario_resp` AS cda_usuario_resp,
     cda.`cont_cda` AS cda_cont_cda,
     cda.`proveedor_sicov` AS cda_proveedor_sicov,
     cda.`usuario_sicov` AS cda_usuario_sicov,
     cda.`orden_bienvenido` AS cda_orden_bienvenido,
     cda.`password_sicov` AS cda_password_sicov,
     cda.`orden_contrato` AS cda_orden_contrato,
     cda.`orden_version` AS cda_orden_version,
     cda.`orden_fecha` AS cda_orden_fecha,
     cda.`url_servicio_sicov` AS cda_url_servicio_sicov,
     cda.`url_servicio_sicov2` AS cda_url_servicio_sicov2,
     cda.`url_servicio_encript` AS cda_url_servicio_encript,
     cda.`id_runt` AS cda_id_runt,
     cda.`cont_test` AS cda_cont_test,
     cda.`orden_codigo` AS cda_orden_codigo,
     v.`Fecha_exp_soat` AS v_Fecha_exp_soat,
     v.`Fecha_soat` AS v_Fecha_soat,
     p.`email` AS p_email,
     hp.`Numero_intentos` AS hp_Numero_intentos,
     software.`nombre` AS software_nombre,
     software.`version` AS software_version,
     software.`Id_sw` AS software_Id_sw,
     min(software.`Id_sw`),
     CASE when hp.Aprobado = 'Y' then 'A' ELSE 'R' END estadoHoja
FROM
     `hoja_pruebas` hp INNER JOIN `vehiculos` v ON hp.`Vehiculo_for` = v.`CAR`
     INNER JOIN `propietarios` p ON hp.`Propietario_for` = p.`CAROWNER`
     INNER JOIN `ciudades` ciudades ON p.`CITY` = ciudades.`CITY`
     INNER JOIN `departamentos` d ON ciudades.`STATE` = d.`id_departamento`
     INNER JOIN `marcas` m ON v.`CARMARK` = m.`CARMARK`
     INNER JOIN `lineas_vehiculos` l ON v.`CARLINE` = l.`CARLINE`
     INNER JOIN `clases_vehiculo` cl ON v.`CLASS` = cl.`CLASS`
     INNER JOIN `servicios` s ON v.`SERVICE` = s.`SERVICE`
     INNER JOIN `tipos_gasolina` tg ON v.`FUELTYPE` = tg.`FUELTYPE`
     INNER JOIN `colores` clr ON v.`COLOR` = clr.`COLOR`
     INNER JOIN `pais` pais ON v.`pais` = pais.`codigo`
     LEFT JOIN tipo_carroceria tp ON v.carroceria = tp.id,
     `cda` cda,
     `software` software
WHERE
     hp.TESTSHEET = ?

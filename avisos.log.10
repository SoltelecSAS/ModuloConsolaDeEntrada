    d.codigo_Resolucion AS d_codigo_Resolucion
FROM 
    pruebas AS pr
INNER JOIN 
    defxprueba AS dp ON pr.id_pruebas = dp.id_prueba
INNER JOIN 
    defectos AS d ON dp.id_defecto = d.CARDEFAULT
LEFT JOIN 
    defectos_grupos_sub_grupos AS gsg ON gsg.id_sub_grupo = d.defgroupssub

ELSE
 pr.id_pruebas in( select max(id_pruebas) from pruebas as p where p.hoja_pruebas_for = ?  and p.Tipo_prueba_for = 1  and p.Finalizada = 'Y'  and p.Abortada = 'N'  and gsg.DEFGROUP = 21  group by p.Tipo_prueba_for)
END
and pr.hoja_pruebas_for = ?
